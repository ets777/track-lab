# TrackLab web version — Apache config for the SPA build (www-web).
# Copied into the build output by `npm run build:web`.

# Serve real files/dirs as-is, send everything else to index.html (Angular routing).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

# sql.js wasm must be served with the right MIME type or streaming compile fails.
AddType application/wasm .wasm

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Hashed build artifacts — safe to cache forever.
  <FilesMatch "\.(js|css|wasm|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Entry point must never be cached, or updates never reach users.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
